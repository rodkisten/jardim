{
  "name": "jardim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node tooling/assets.mjs && esbuild apps/api/src/index.ts --bundle --minify --format=esm --platform=browser --outfile=dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run build && wrangler types && npm run typecheck && npm test",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "predev": "npm run format",
    "prebuild": "npm run format",
    "pretest": "npm run format"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.21",
    "dexie": "4.4.7",
    "solid-js": "2.0.0-rc.21",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@cloudflare/workers-types": "5.20261112.1",
    "@playwright/test": "1.65.0",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.6.6",
    "babel-preset-solid": "2.0.0-rc.2",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  }
}

{
  "name": "jardim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "turbo run dev --filter=@rodkisten/jardim-web",
    "dev:api": "wrangler dev --local-protocol https",
    "build": "turbo run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "eslint . && turbo run build && wrangler types && tsc --noEmit && vitest run",
    "deploy": "turbo run build && wrangler deploy",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "predev": "prettier --write . --ignore-unknown",
    "prebuild": "prettier --write . --ignore-unknown",
    "pretest": "prettier --write . --ignore-unknown",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:validate": "prisma validate --schema packages/database/prisma/schema.prisma",
    "db:migrate:local": "wrangler d1 migrations apply jardim --local",
    "db:migrate:remote": "wrangler d1 migrations apply jardim --remote"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@cloudflare/workers-types": "5.20261112.1",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.6.6",
    "babel-preset-solid": "2.0.0-rc.2",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.161.0",
    "turbo": "2.11.11",
    "prisma": "7.10.1",
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.2",
    "globals": "17.14.0",
    "@rodkisten/jardim-contracts": "workspace:*",
    "@rodkisten/jardim-local-db": "workspace:*",
    "@rodkisten/jardim-database": "workspace:*",
    "@rodkisten/jardim-capture": "workspace:*",
    "@rodkisten/jardim-cards": "workspace:*"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}

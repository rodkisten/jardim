{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jardim",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jardim",
      "database_id": "83d55918-db72-4dd4-8f5d-08d15df2c009",
      "migrations_dir": "infra/cloudflare/migrations",
    },
  ],
  "routes": [
    {
      "pattern": "jardim.migos.club",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "vars": {
    "APP_ORIGIN": "https://jardim.migos.club",
  },
  "secrets": {
    "required": ["JARDIM_PASSWORD"],
  },
}
